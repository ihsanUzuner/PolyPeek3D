Windows Registry Editor Version 5.00

; Developer install (Install.bat): file associations for C:\PolyPeek3D, current user only.
; Keep the format table in step with installer\PolyPeek3D.iss and portable\Associate-Files.bat.

[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.fbx\UserChoice]

[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.fbx\UserChoiceLatest]

[HKEY_CURRENT_USER\Software\Classes\.fbx]
@="PolyPeek3D.fbx"

[HKEY_CURRENT_USER\Software\Classes\.fbx\OpenWithProgids]
"PolyPeek3D.fbx"=""

[HKEY_CURRENT_USER\Software\Classes\PolyPeek3D.fbx]
@="FBX 3D Model"

[HKEY_CURRENT_USER\Software\Classes\PolyPeek3D.fbx\DefaultIcon]
@="C:\\PolyPeek3D\\icons\\fbx.ico"

[HKEY_CURRENT_USER\Software\Classes\PolyPeek3D.fbx\shell\open\command]
@="\"C:\\PolyPeek3D\\PolyPeek3D.exe\" \"%1\""

